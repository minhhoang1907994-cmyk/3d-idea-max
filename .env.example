# Chuỗi kết nối Neon mà app dùng để đọc/ghi dữ liệu ý tưởng.
#
# ⚠️ PHẢI là chuỗi của role `app_editor` (xem db/migrations/002_app_editor_role.sql),
# TUYỆT ĐỐI KHÔNG dùng chuỗi của `neondb_owner`: giá trị này nằm trong bundle nên ai
# xem source trang web cũng lấy được, mà `neondb_owner` xoá được cả database.
#
# Lấy trong Neon Console: nút Connect > chọn Role = app_editor > Copy snippet.
# Dạng: postgresql://app_editor:<mật khẩu>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
#
# Bỏ trống hoặc không có file .env: app vẫn chạy bằng dữ liệu đóng gói trong src/data/json/,
# nhưng sửa ở trang Quản lý dữ liệu sẽ mất khi tải lại trang.
VITE_NEON_DATABASE_URL=

# ---- Backblaze B2: nơi lưu ảnh của trang Sổ công ty ----
#
# ⚠️ Bốn giá trị dưới đây NẰM TRONG BUNDLE — ai xem source trang web cũng lấy được.
# Vì vậy PHẢI dùng application key giới hạn đúng một bucket và KHÔNG cấp deleteFiles,
# cùng tinh thần với role app_editor của Neon. Cách tạo: docs/backblaze-setup.md
#
# Bỏ trống: ô "Hình ảnh" quay về dạng dán link như trước, app vẫn chạy bình thường.

VITE_B2_KEY_ID=
VITE_B2_APPLICATION_KEY=
VITE_B2_BUCKET=
# Host của S3-Compatible API, xem dòng "Endpoint" trong trang bucket trên Backblaze
VITE_B2_ENDPOINT=s3.us-east-005.backblazeb2.com
